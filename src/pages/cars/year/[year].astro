---
import Layout from "../../../layouts/Layout.astro";
import PlotFigure from "../../../components/PlotFigure.astro";
import cars from "../../../assets/cars.json";
import * as Plot from "@observablehq/plot";

export async function getStaticPaths() {
  const allYears = [...new Set(cars.map((c) => c.year))];
  return allYears.map((year) => ({
    params: { year: year.toString() },
    props: { filteredCars: cars.filter(c => c.year === year) },
  }));
}

const { year } = Astro.params;
const { filteredCars } = Astro.props;

const plotOptions = {
  grid: true,
  marks: [
    Plot.dot(filteredCars, {
      x: "weight (lb)",
      y: "power (hp)",
      fill: "steelblue",
      r: 4,
      fillOpacity: 0.7,
      title: "name"
    }),
  ],
  x: { label: "Poids (lb)" },
  y: { label: "Puissance (hp)" },
  title: `Relation Puissance vs Poids - Voitures ${year}`,
};
---
<Layout>
  <div class="max-w-5xl mx-auto py-8 px-4">
    <div class="mb-8 border-b border-gray-200 pb-6">
      <a href="/cars/year" class="inline-flex items-center text-sm font-medium text-blue-600 hover:text-blue-800 mb-4 transition-colors">
        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        Retour aux années
      </a>
      <h1 class="text-3xl font-extrabold text-gray-900">Voitures de l'année {year}</h1>
      <p class="text-gray-500 mt-2">{filteredCars.length} voiture(s) trouvée(s) pour l'année {year}</p>
    </div>

    <div class="bg-white p-6 rounded-2xl shadow-md border border-gray-100 overflow-x-auto text-black">
      <PlotFigure options={plotOptions} />
    </div>
  </div>
</Layout>